# Use separate projects and developer applications for staging and production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CAST_SUPABASE_PUBLISHABLE_KEY=
CAST_SUPABASE_SECRET_KEY=
CAST_ENABLED=false
CAST_ALLOWED_ORIGINS=https://account.younglion.xyz
# Must be an existing authenticated page that uses clients/account.ts.
CAST_COMPLETE_URL=https://account.younglion.xyz/connections
CAST_OAUTH_CLIENT_IDS=

# Generate independent random keys; do not use the examples as secret values.
CAST_TOKEN_KEY_ID=v1
CAST_TOKEN_KEYS={"v1":"REPLACE_WITH_32_RANDOM_BYTES_BASE64"}
CAST_MAINTENANCE_SECRET=

CAST_LOGIN_TWITCH_CLIENT_ID=
CAST_LOGIN_TWITCH_CLIENT_SECRET=
# Used by configure-auth.ts to create custom:kick, not by the UserInfo handler.
CAST_LOGIN_KICK_CLIENT_ID=
CAST_LOGIN_KICK_CLIENT_SECRET=
CAST_PUBLISH_TWITCH_CLIENT_ID=
CAST_PUBLISH_TWITCH_CLIENT_SECRET=
CAST_PUBLISH_KICK_CLIENT_ID=
CAST_PUBLISH_KICK_CLIENT_SECRET=
