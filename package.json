{
  "name": "younglion-cast",
  "version": "0.3.0",
  "private": true,
  "description": "YoungLion Cast account and OAuth infrastructure",
  "scripts": {
    "test": "deno test --allow-env --allow-net --allow-read tests/",
    "check": "deno check supabase/functions/*/index.ts clients/account.ts scripts/configure-auth.ts",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "verify": "npm run check && npm run lint && npm run fmt:check && npm test",
    "test:database": "deno test --allow-env --allow-net --allow-read tests/database_test.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "deno": "2.5.6",
    "postgres": "3.4.7"
  },
  "license": "GPL-3.0-or-later"
}
